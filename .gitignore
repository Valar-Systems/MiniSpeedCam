# --- KiCad -----------------------------------------------------------------
# Auto-backup archives + lock/cache/temp files KiCad regenerates on its own.
*-backups/
*.lck
*-bak
fp-info-cache
_autosave-*
*.tmp
# Per-user project-local settings (window/panel state) — not shared.
*.kicad_prl

# --- Editor "Local History" (VS Code Local History extension, etc.) --------
.history/
*.code-workspace

# --- PlatformIO build output ----------------------------------------------
.pio/

# --- Device / serial-monitor logs (PlatformIO device monitor, etc.) --------
logs/
*.log
